[0.798, "o", "Plan for claude-code+anthropic+@antialias/shop-inventory@1+github-mcp+playwright+preview+./weekend\r\n\r\nApply order:\r\n  1. claude-code  (setup.sh, up to 5m)\r\n  2. anthropic\r\n  3. @antialias/shop-inventory@1\r\n  4. github-mcp\r\n  5. playwright  (setup.sh, up to 20m)\r\n  6. preview\r\n  7. ./weekend\r\n  -- checkpoint \"profiled: claude-code+anthropic+@antialias/shop-inventory@1+github-mcp+playwright+preview+./weekend\" --\r\n\r\nSources:\r\n  @antialias/shop-inventory@1  publisher antialias, repo antialias/sprite-profile-shop-inventory, @antialias/shop-inventory@1.0.0 = fd585e06, no setup.sh\r\n\r\nInputs:\r\n  readonly = \"true\" (default)  (github-mcp)\r\n  toolsets = \"\" (default)  (github-mcp)\r\n\r\nLabels:\r\n  profile:claude-code\r\n  profile:anthropic\r\n  profile:antialias.shop-inventory\r\n  profile:github-mcp\r\n  profile:playwright\r\n  profile:preview\r\n  profile:weekend\r\n\r\nConnectors:\r\n  custom_api anthropic  (anthropic): base URL https://api.anthropic.com, auth custom_header (x-api-key), endpoints /v1/*; must admit a Sprite labelled profil"]
[0.000, "o", "e:anthropic\r\n  custom_api antialias.shop-inventory  (@antialias/shop-inventory@1): base URL https://woodworking.haunt.house, auth header (Bearer), endpoints /mcp; must admit a Sprite labelled profile:antialias.shop-inventory\r\n  custom_api github-mcp  (github-mcp): base URL https://api.githubcopilot.com, auth header (Bearer), endpoints /mcp/; must admit a Sprite labelled profile:github-mcp\r\n\r\nNetwork policy:\r\n  include defaults\r\n  allow mcp.context7.com\r\n  allow console.anthropic.com\r\n  allow platform.claude.com\r\n  allow api.sprites.dev\r\n  allow cdn.playwright.dev\r\n  allow example.com\r\n\r\nEnv:\r\n  ANTHROPIC_API_KEY = \"placeholder-the-fly-gateway-adds-the-key\"  (anthropic)\r\n  ANTHROPIC_BASE_URL = <custom_api connector gateway URL>  (anthropic)\r\n  DISABLE_AUTOUPDATER = \"1\"  (claude-code)\r\n  GITHUB_MCP_READONLY = \"true\"  (github-mcp)\r\n  GITHUB_MCP_TOOLSETS = \"\"  (github-mcp)\r\n  GITHUB_MCP_URL = <custom_api connector gateway URL>  (github-mcp)\r\n  SHOP_INVENTORY_URL = <custom_api connector gateway URL>  (@antialias/s"]
[0.000, "o", "hop-inventory@1)\r\n\r\nServices:\r\n  preview: python3 -m http.server 8080, http_port 8080  (preview)\r\n\r\nMCP servers:\r\n  context7 (http) https://mcp.context7.com/mcp  (claude-code)\r\n  shop (http) ${SHOP_INVENTORY_URL}/mcp, credential added by the gateway  (@antialias/shop-inventory@1)\r\n  github (http) ${GITHUB_MCP_URL}/mcp/, credential added by the gateway  (github-mcp)\r\n\r\nClaude settings:\r\n  env.BASH_DEFAULT_TIMEOUT_MS = \"600000\"\r\n  hooks.PreToolUse = [{\"hooks\":[{\"command\":\"~/.config/profiled/hooks/task-hold.sh hold\",\"type\":\"command\"}]}]\r\n  hooks.Stop = [{\"hooks\":[{\"command\":\"~/.config/profiled/hooks/task-hold.sh release\",\"type\":\"command\"}]}]\r\n  hooks.UserPromptSubmit = [{\"hooks\":[{\"command\":\"~/.config/profiled/hooks/task-hold.sh hold\",\"type\":\"command\"}]}]\r\n  permissions.allow = [\"Skill\",\"mcp__shop\",\"mcp__github\",\"Edit(~/site/**)\",\"Bash(curl:*)\",\"Bash(env:*)\",\"Bash(grep:*)\",\"Bash(head:*)\",\"Bash(npx playwright screenshot:*)\"]\r\n\r\nSkills:\r\n  ~/.claude/skills/claude-code--profiled/  (claude-code)\r\n  ~/.claude/skills/"]
[0.000, "o", "antialias.shop-inventory--shop-inventory/  (@antialias/shop-inventory@1)\r\n  ~/.claude/skills/github-mcp--github/  (github-mcp)\r\n  ~/.claude/skills/weekend--weekend-page/  (./weekend)\r\n\r\nFiles:\r\n  ~/.config/profiled/hooks/task-hold.sh  (claude-code)\r\n  ~/.config/profiled/playwright/smoke.js  (playwright)\r\n  ~/site/index.html  (preview)\r\n\r\n"]
